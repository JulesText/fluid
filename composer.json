{
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "phpcompatibility/php-compatibility": "^10.0.0@dev",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "scripts": {
    "format:php": "phpcbf --standard=phpcs.xml.dist",
    "check:php": "phpcs --standard=phpcs.xml.dist",
    "check:php-compat": "phpcs --standard=phpcompat.xml.dist",
    "review:php-lines": "phpcs --standard=phpcs-lines.xml.dist"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
