<?xml version="1.0"?>
<ruleset name="Fluid PHP compatibility">
    <description>PHP 7.4 through 8.3 compatibility checks for the Fluid codebase.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <config name="testVersion" value="7.4-8.3"/>

    <file>.</file>

    <exclude-pattern>config_private.php</exclude-pattern>
    <exclude-pattern>dt/node_modules/*</exclude-pattern>
    <exclude-pattern>media/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>

    <rule ref="PHPCompatibility"/>

    <rule ref="Internal.NoCodeFound">
        <severity>0</severity>
    </rule>
</ruleset>
